{
  "name": "@gitgem/explainer-tool",
  "version": "1.0.0",
  "type": "module",
  "description": "Free, open-source tool from Gitgem.org that creates narrated motion-graphics explainer videos",
  "private": true,
  "author": "Gitgem.org",
  "license": "MIT",
  "homepage": "https://gitgem.org",
  "repository": {
    "type": "git",
