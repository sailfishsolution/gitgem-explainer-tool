  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "wrangler": "^4.136.0"
